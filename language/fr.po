#: src/Controller/Admin/CheckAndFixController.php:1213
msgid ""
"Privacy leak: the api exposes user emails to anonymous requests (/api/users)."
msgstr ""
"Fuite de confidentialité : l’api expose les emails des utilisateurs aux "
"requêtes anonymes (/api/users)."

#: src/Controller/Admin/CheckAndFixController.php:1215
msgid "Api probe: anonymous access to users does not expose emails."
msgstr "Sonde api : l’accès anonyme aux utilisateurs n’expose pas d’emails."

