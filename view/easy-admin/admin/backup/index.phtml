<?php // Existing backups list ?>
<div id="backup-list" class="block">
    <h2><?= $translate('Existing backups') ?></h2>

    <?php foreach ($runningJobs as $job): ?>
    <div class="messages warning">
        <p><?= sprintf(
            $escape($translate('A backup is in progress (job %s), since %s. Its file is not complete yet: reload the page later.')),
            $hyperlink('#' . $job->getId(), $url('admin/id', ['controller' => 'job', 'id' => $job->getId()])),
            $escape($job->getStarted() ? $job->getStarted()->format('Y-m-d H:i:s') : '')
        ) ?></p>
    </div>
    <?php endforeach; ?>

    <?php if ($backups): ?>
    <table class="tablesaw" data-tablesaw-mode="stack">
        <thead>
            <tr>
                <th><?= $translate('Filename') ?></th>
                <th><?= $translate('Type') ?></th>
                <th><?= $translate('Date') ?></th>
                <th><?= $translate('Size') ?></th>
                <th><?= $translate('Actions') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($backups as $backup): ?>
            <tr>
                <td><?= $escape($backup['name']) ?></td>
                <td>
                    <?php if ($backup['type'] === 'database'): ?>
                    <span class="backup-type database"><?= $translate('Database') ?></span>
                    <?php else: ?>
                    <span class="backup-type files"><?= $translate('Files') ?></span>
                    <?php endif; ?>
                </td>
                <td><?= date('Y-m-d H:i:s', $backup['mtime']) ?></td>
                <?php if ($backup['in_progress']): ?>
                <td><em><?= $escape($translate('In progress')) ?></em></td>
                <td class="actions"></td>
                <?php else: ?>
                <td><?= $formatSize($backup['size']) ?></td>
                <td class="actions">
                    <a href="<?= $escapeAttr($url(null, ['action' => 'download'], ['query' => ['file' => $backup['name']]], true)) ?>"
                       class="o-icon-download" title="<?= $translate('Download') ?>" aria-label="<?= $translate('Download') ?>"></a>
                    <a href="#" class="o-icon-delete delete-backup"
                       data-url-sidebar-content="<?= $escapeAttr($url(null, ['action' => 'delete-confirm'], ['query' => ['filename' => $backup['name']]], true)) ?>"
                       title="<?= $translate('Delete') ?>" aria-label="<?= $translate('Delete') ?>"></a>
                </td>
                <?php endif; ?>
            </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
    <?php else: ?>
    <p class="no-backups"><?= $translate('No backups found.') ?></p>
    <?php endif; ?>
