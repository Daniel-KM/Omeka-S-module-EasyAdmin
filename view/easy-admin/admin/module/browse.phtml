                            <button type="submit" name="state_action_id" value="install-module:<?= $escape($moduleId) ?>"
                                formaction="<?= $escape($url('admin/easy-admin/default', ['controller' => 'module', 'action' => 'install-module'], ['query' => ['id' => $moduleId]])) ?>"
                                class="o-icon-install button"
                                title="<?= $escapeAttr($translate('Install')) ?>"
                                aria-label="<?= $escapeAttr($translate('Install')) ?>"
                                ><?= $translate('Install') ?></button>
                        </li>
                        <?php endif ?>

                        <?php if (Manager::STATE_NOT_ACTIVE === $state): ?>
