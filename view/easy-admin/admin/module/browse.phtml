foreach ($omekaModules as $catUrl => $m) {
    $catalogueList[$catUrl] = $m + ['is_omeka' => true];
}
foreach ($webModules as $catUrl => $m) {
    if (!isset($catalogueList[$catUrl])) {
        $catalogueList[$catUrl] = $m + ['is_omeka' => false];
    }
}
