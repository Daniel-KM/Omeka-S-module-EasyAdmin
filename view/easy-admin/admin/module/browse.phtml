<div id="sidebar-install" class="sidebar">
    <?= $hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Close'),
        'aria-label' => $translate('Close'),
    ]) ?>
    <div class="sidebar-content">
        <h3><?= $escape($translate('Install new module from catalogue')) ?></h3>
       <p class="explanation">
            <?= $escape($translate('Select the modules to install or use a curated selection.')) ?>
            <?= sprintf($translate('For more information, see pages of known %1$smodules%2$s or %3$sOmeka.org%2$s.'),
                '<a href="https://daniel-km.github.io/UpgradeToOmekaS/omeka_s_modules.html" rel="noopener" target="_blank">', '</a>',
                '<a href="https://omeka.org/s/modules/" rel="noopener" target="_blank">') ?>
        </p>
        <?php if ($selections): ?>
        <div class="field">
            <label for="selection-filter"><?= $escape($translate('Curated selection')) ?></label>
            <select id="selection-filter">
                <option value=""><?= $escape($translate('Select a selection…')) ?></option>
                <?php foreach ($selections as $selName => $selAddons): ?>
                <option value="<?= $escape($selName) ?>"><?= $escape($selName) ?></option>
                <?php endforeach ?>
            </select>
        </div>
        <?php endif ?>

        <div class="field addon-install-filter-field">
            <input type="search" class="addon-install-filter" placeholder="<?= $escapeAttr($translate('Filter modules…')) ?>" aria-label="<?= $escapeAttr($translate('Filter modules…')) ?>">
        </div>

        <?php
        $installCatalogueForm->prepare();
        echo $this->form()->openTag($installCatalogueForm);
        ?>
        <div class="addon-checklist">
            <?php foreach ($catalogueList as $catUrl => $catModule):
                if (!empty($catModule['installed'])) {
                    continue;
                }
                $dir = $catModule['dir'] ?? '';
                $sourceUrl = $catModule['url'] ?? '';
                $compatible = $catModule['is_compatible'] ?? true;
                $requiredConstraint = $catModule['required_constraint'] ?? '';
            ?>
            <label class="addon-check-item<?= $compatible ? '' : ' incompatible' ?>">
                <input type="checkbox" name="module_urls[]" value="<?= $escape($catUrl) ?>" data-addon-dir="<?= $escape($dir) ?>"<?= $compatible ? '' : ' disabled="disabled"' ?>>
                <span class="addon-check-name"><?= $escape($catModule['name']) ?></span>
                <?php if (!$compatible): ?>
                <span class="addon-check-incompatible"><?= $escape(sprintf($translate('Requires Omeka S %s'), $requiredConstraint)) ?></span>
                <?php endif ?>
                <span class="addon-check-source">
                <?php if (!empty($catModule['is_omeka'])): ?>
                    <a href="<?= $escape('https://omeka.org/s/modules/' . $dir) ?>" target="_blank" rel="noopener noreferrer" class="o-icon-omeka" title="Omeka.org" aria-label="Omeka.org" onclick="event.stopPropagation();"></a>
                <?php elseif ($sourceUrl): ?>
                    <a href="<?= $escape($sourceUrl) ?>" target="_blank" rel="noopener noreferrer" class="o-icon-external" title="<?= $escape($translate('Source')) ?>" aria-label="<?= $escape($translate('Source')) ?>" onclick="event.stopPropagation();"></a>
                <?php endif ?>
                </span>
            </label>
            <?php endforeach ?>
        </div>
        <div class="confirm-panel">
            <button type="submit"><?= $escape($translate('Install selected')) ?></button>
        </div>
        <?= $this->form()->closeTag($installCatalogueForm) ?>
    </div>
</div>

<script>

<?php if ($selections): ?>
var selections = <?= json_encode($selections, JSON_UNESCAPED_UNICODE) ?>;
$('#selection-filter').on('change', function() {
    var name = $(this).val();
    var dirs = (name && selections[name])
        ? selections[name].map(function(d) { return d.replace(/\s/g, ''); })
        : [];
    // Catalogue checkboxes of the sidebar (modules to install).
    $('.addon-checklist input[type="checkbox"]').each(function() {
        var dir = ($(this).data('addon-dir') || '').replace(/\s/g, '');
        $(this).prop('checked', dirs.indexOf(dir) !== -1);
    });
    // Checkboxes of the main list (modules of the selection already present),
    // so they can be acted on in batch.
    $('input[name="modules[]"]').each(function() {
        var id = ($(this).val() || '').replace(/\s/g, '');
        $(this).prop('checked', dirs.indexOf(id) !== -1);
    });
});
<?php endif ?>
</script>
